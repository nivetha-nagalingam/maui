<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Maui.Controls.Sample"
             x:Class="Maui.Controls.Sample.WebViewOptionsPage"
             Title="WebView Options">
        <ContentPage.ToolbarItems>
                <ToolbarItem Text="Apply"
                             Clicked="ApplyButton_Clicked"
                             AutomationId="Apply"/>
        </ContentPage.ToolbarItems>
        <VerticalStackLayout Padding="5"
                             Spacing="5">
                <Label Text="Source:"
                       FontSize="15"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout  Spacing="3">
                        <Button x:Name="HtmlSourceButton"
                                AutomationId="HtmlSourceButton"
                                Text="HTML"
                                Clicked="OnHtmlSourceClicked"/>
                        <Button x:Name="MicrosoftUrlButton"
                                AutomationId="MicrosoftUrlButton"
                                Text="Microsoft"
                                Clicked="OnMicrosoftUrlClicked"/>
                        <Button x:Name="GithubUrlButton"
                                AutomationId="GithubUrlButton"
                                Text="Github"
                                Clicked="OnGithubUrlClicked"/>
                </HorizontalStackLayout>
                <Label Text="Cookie Management:"
                       FontSize="15"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout
                        Spacing="3">
                        <Button Text="Add Test Cookie"
                                Clicked="AddTestCookie_Clicked"
                                AutomationId="AddTestCookieButton"/>
                        <Button Text="Clear Cookies"
                                Clicked="ClearCookies_Clicked"
                                AutomationId="ClearCookiesButton"/>
                </HorizontalStackLayout>
                <Label Text="Navigation Testing:"
                       FontSize="15"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout
                        Spacing="2">
                        <Button Text="Page 1"
                                Clicked="LoadPage1_Clicked"
                                AutomationId="LoadPage1Button"/>
                        <Button Text="Page 2"
                                Clicked="LoadPage2_Clicked"
                                AutomationId="LoadPage2Button"/>
                        <Button Text="Multiple Pages"
                                Clicked="LoadMultiplePages_Clicked"
                                AutomationId="LoadMultiplePagesButton"/>
                </HorizontalStackLayout>

                <Label Text="Is Visible"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="3">
                        <RadioButton Content="True"
                                     IsChecked="True"
                                     GroupName="IsVisibleGroup"
                                     CheckedChanged="IsVisibleRadio_CheckedChanged"
                                     AutomationId="IsVisibleTrue"/>
                        <RadioButton Content="False"
                                     GroupName="IsVisibleGroup"
                                     CheckedChanged="IsVisibleRadio_CheckedChanged"
                                     AutomationId="IsVisibleFalse"/>
                </HorizontalStackLayout>

                <Label Text="Shadow"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="3">
                        <RadioButton Content="False"
                                     IsChecked="True"
                                     GroupName="ShadowGroup"
                                     CheckedChanged="ShadowRadio_CheckedChanged"
                                     AutomationId="ShadowFalse"/>
                        <RadioButton Content="True"
                                     GroupName="ShadowGroup"
                                     CheckedChanged="ShadowRadio_CheckedChanged"
                                     AutomationId="ShadowTrue"/>
                </HorizontalStackLayout>
                <Label Text="User Agent"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <Entry Text="{Binding UserAgent}"
                       Placeholder="Enter custom user agent"
                       TextChanged="UserAgentEntry_TextChanged"
                       AutomationId="UserAgentEntry"/>
                <Label Text="Opacity"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="3">
                        <RadioButton Content="1"
                                     IsChecked="True"
                                     GroupName="OpacityGroup"
                                     CheckedChanged="OpacityRadio_CheckedChanged"
                                     AutomationId="Opacity1"/>
                        <RadioButton Content="0.5"
                                     GroupName="OpacityGroup"
                                     CheckedChanged="OpacityRadio_CheckedChanged"
                                     AutomationId="Opacity05"/>
                        <RadioButton Content="0"
                                     GroupName="OpacityGroup"
                                     CheckedChanged="OpacityRadio_CheckedChanged"
                                     AutomationId="Opacity0"/>
                </HorizontalStackLayout>


                <Label Text="Background Color"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="3">
                        <RadioButton Content="Default"
                                     IsChecked="True"
                                     GroupName="BackgroundColorGroup"
                                     CheckedChanged="BackgroundColorRadio_CheckedChanged"
                                     AutomationId="BackgroundColorDefault"/>
                        <RadioButton Content="Red"
                                     GroupName="BackgroundColorGroup"
                                     CheckedChanged="BackgroundColorRadio_CheckedChanged"
                                     AutomationId="BackgroundColorRed"/>
                        <RadioButton Content="Blue"
                                     GroupName="BackgroundColorGroup"
                                     CheckedChanged="BackgroundColorRadio_CheckedChanged"
                                     AutomationId="BackgroundColorBlue"/>
                </HorizontalStackLayout>
                <Label Text="Cancel Navigation"
                       FontSize="16"
                       FontAttributes="Bold"/>
                <HorizontalStackLayout Spacing="3">
                        <RadioButton Content="False"
                                     IsChecked="True"
                                     GroupName="CancelNavigationGroup"
                                     CheckedChanged="CancelNavigationRadio_CheckedChanged"
                                     AutomationId="CancelNavigationFalse"/>
                        <RadioButton Content="True"
                                     GroupName="CancelNavigationGroup"
                                     CheckedChanged="CancelNavigationRadio_CheckedChanged"
                                     AutomationId="CancelNavigationTrue"/>
                </HorizontalStackLayout>
        </VerticalStackLayout>
</ContentPage>